<div class="cottonfall-fx-panel">

  <header class="cottonfall-fx-header">
    <h1>COTTONFALL FX</h1>
    <div class="cottonfall-fx-subtitle">
      Atmospheric Control System
    </div>
  </header>

  <section class="cottonfall-fx-section">
    <h2>Reality</h2>

    <button
      type="button"
      data-action="realityGlitch"
      class="cottonfall-fx-button"
    >
      <i class="fas fa-bolt"></i>
      Reality Glitch
    </button>
  </section>

  <section class="cottonfall-fx-section cottonfall-fx-future">
    <h2>Coming Later</h2>

    <button
      type="button"
      data-action="threeSeventeen"
      class="cottonfall-fx-button"
    >
      <i class="fas fa-clock"></i>
      3:17 Event
    </button>

    <div class="cottonfall-fx-placeholder">
      <i class="fas fa-smog"></i>
      Cottonfall Fog
    </div>

    <div class="cottonfall-fx-placeholder">
      <i class="fas fa-lightbulb"></i>
      Power Flicker
    </div>

    <div class="cottonfall-fx-placeholder">
      <i class="fas fa-ghost"></i>
      Something in the Fog
    </div>

    <div class="cottonfall-fx-placeholder">
      <i class="fas fa-radio"></i>
      Emergency Broadcast
    </div>
  </section>

</div>

