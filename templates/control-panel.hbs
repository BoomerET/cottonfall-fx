
<div class="cottonfall-fx-panel">

  <!-- =====================================================
       HEADER
       ===================================================== -->

  <header class="cottonfall-fx-header">
    <h1>COTTONFALL FX</h1>

    <div class="cottonfall-fx-subtitle">
      Atmospheric Control System
    </div>
  </header>


  <!-- =====================================================
       VISUAL GLITCH
       ===================================================== -->

  <section class="cottonfall-fx-section">
    <h2>Visual Glitch</h2>

    <button
      type="button"
      data-action="toggleGlitch"
      class="cottonfall-fx-button {{#if glitchActive}}cottonfall-fx-active{{/if}}"
    >
      <i class="fas fa-wave-square"></i>
      {{#if glitchActive}}Glitch: ON{{else}}Glitch: OFF{{/if}}
    </button>

    <div class="cottonfall-fx-row">

      <button
        type="button"
        data-action="glitchSubtle"
        class="cottonfall-fx-button cottonfall-fx-mini"
      >
        Subtle
      </button>

      <button
        type="button"
        data-action="glitchVHS"
        class="cottonfall-fx-button cottonfall-fx-mini"
      >
        VHS
      </button>

      <button
        type="button"
        data-action="glitchHard"
        class="cottonfall-fx-button cottonfall-fx-mini"
      >
        Hard
      </button>

    </div>
  </section>


  <!-- =====================================================
       REALITY
       ===================================================== -->

  <section class="cottonfall-fx-section">
    <h2>Reality</h2>

    <div class="cottonfall-fx-row">

      <button
        type="button"
        data-action="realityLurch"
        class="cottonfall-fx-button cottonfall-fx-mini"
      >
        <i class="fas fa-bolt"></i>
        Reality Lurch
      </button>

      <button
        type="button"
        data-action="fullBreak"
        class="cottonfall-fx-button cottonfall-fx-mini"
      >
        <i class="fas fa-explosion"></i>
        Full Break
      </button>

    </div>
  </section>


  <!-- =====================================================
       EVENTS
       ===================================================== -->

  <section class="cottonfall-fx-section">
    <h2>Events</h2>

    <button
      type="button"
      data-action="threeSeventeen"
      class="cottonfall-fx-button"
    >
      <i class="fas fa-clock"></i>
      3:17 Event
    </button>
  </section>


  <!-- =====================================================
       ATMOSPHERE
       ===================================================== -->

  <section class="cottonfall-fx-section">
    <h2>Atmosphere</h2>

    <div class="cottonfall-fx-atmosphere-row">

      <button
        type="button"
        data-action="fogOn"
      >
        <i class="fas fa-cloud"></i>
        Fog In
      </button>

      <button
        type="button"
        data-action="fogOff"
      >
        <i class="fas fa-wind"></i>
        Clear Fog
      </button>

      <button
        type="button"
        data-action="powerFlicker"
      >
        <i class="fas fa-bolt"></i>
        Flicker
      </button>

    </div>
  </section>


  <!-- =====================================================
       SOMETHING IN THE FOG
       ===================================================== -->

  <section class="cottonfall-fx-section">
    <h2>Something in the Fog</h2>

    <div class="cottonfall-fx-shadow-timings">

      <label>
        Fade In (s)
        <input
          type="number"
          name="shadowFadeIn"
          value="{{shadowFadeIn}}"
          min="1"
          max="30"
          step="1"
        />
      </label>

      <label>
        Remains Visible (s)
        <input
          type="number"
          name="shadowHold"
          value="{{shadowHold}}"
          min="1"
          max="30"
          step="1"
        />
      </label>

      <label>
        Fade Out (s)
        <input
          type="number"
          name="shadowFadeOut"
          value="{{shadowFadeOut}}"
          min="1"
          max="30"
          step="1"
        />
      </label>

    </div>

    <button
      type="button"
      data-action="shadowPlace"
      class="cottonfall-fx-button"
    >
      <i class="fas fa-user-secret"></i>
      Place Apparition
    </button>
  </section>


  <!-- =====================================================
       EMERGENCY BROADCAST
       ===================================================== -->

  <section class="cottonfall-fx-section">
    <h2>Emergency Broadcast</h2>

    <div class="cottonfall-fx-emergency">

      <!-- Broadcast Preset -->

      <label>
        Broadcast Preset
        <select name="emergencyPreset">
          <option value="custom">Custom Message</option>
          <option value="shelter">Shelter in Place</option>
          <option value="missing">Missing Resident</option>
          <option value="transmission">Unidentified Transmission</option>
          <option value="317">3:17 Protocol</option>
        </select>
      </label>


      <!-- Broadcast Title -->

      <label>
        Broadcast Title
        <input
          type="text"
          name="emergencyTitle"
          value="{{emergencyTitle}}"
          placeholder="Emergency title"
        />
      </label>


      <!-- Emergency Message -->

      <label>
        Emergency Message
        <textarea
          name="emergencyMessage"
          rows="5"
          placeholder="Enter the emergency announcement..."
        >{{emergencyMessage}}</textarea>
      </label>


      <!-- Broadcast Duration -->

      <label>
        Duration (seconds — 0 = Until Dismissed)
        <input
          type="number"
          name="emergencyDuration"
          value="{{emergencyDuration}}"
          min="0"
          max="300"
          step="1"
        />
      </label>


      <!-- Broadcast Controls -->

      <div class="cottonfall-fx-row">

        <button
          type="button"
          data-action="emergencyBroadcast"
        >
          <i class="fas fa-broadcast-tower"></i>
          Broadcast
        </button>

        <button
          type="button"
          data-action="emergencyDismiss"
        >
          <i class="fas fa-times-circle"></i>
          Dismiss
        </button>

      </div>

    </div>
  </section>

</div>
