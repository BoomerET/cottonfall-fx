<div class="cottonfall-fx-panel">

  <header class="cottonfall-fx-header">
    <h1>COTTONFALL FX</h1>
    <div class="cottonfall-fx-subtitle">
      Atmospheric Control System
    </div>
  </header>

  <section class="cottonfall-fx-section">
    <h2>Visual Glitch</h2>

    <button
      type="button"
      data-action="toggleGlitch"
      class="cottonfall-fx-button {{#if glitchActive}}cottonfall-fx-active{{/if}}"
    >
      <i class="fas fa-wave-square"></i>
      {{#if glitchActive}}Glitch: ON{{else}}Glitch: OFF{{/if}}
    </button>

    <div class="cottonfall-fx-row">
      <button type="button" data-action="glitchSubtle" class="cottonfall-fx-button cottonfall-fx-mini">
        Subtle
      </button>
      <button type="button" data-action="glitchVHS" class="cottonfall-fx-button cottonfall-fx-mini">
        VHS
      </button>
      <button type="button" data-action="glitchHard" class="cottonfall-fx-button cottonfall-fx-mini">
        Hard
      </button>
    </div>
  </section>

  <section class="cottonfall-fx-section">
    <h2>Reality</h2>

    <button type="button" data-action="realityLurch" class="cottonfall-fx-button">
      <i class="fas fa-bolt"></i>
      Reality Lurch
    </button>

    <button type="button" data-action="fullBreak" class="cottonfall-fx-button">
      <i class="fas fa-explosion"></i>
      Full Break
    </button>
  </section>

  <section class="cottonfall-fx-section">
    <h2>Events</h2>

    <button type="button" data-action="threeSeventeen" class="cottonfall-fx-button">
      <i class="fas fa-clock"></i>
      3:17 Event
    </button>
  </section>

  <section class="cottonfall-fx-section">
    <h2>Atmosphere</h2>

    <button type="button" data-action="fogOn" class="cottonfall-fx-button">
      <i class="fas fa-cloud"></i>
      Fog Rolls In
    </button>

    <button type="button" data-action="fogOff" class="cottonfall-fx-button">
      <i class="fas fa-wind"></i>
      Clear Fog
    </button>

    <button
      type="button"
      data-action="powerFlicker"
      class="cottonfall-fx-button"
    >
      <i class="fas fa-bolt"></i>
      Power Flicker
    </button>

    <button 
      type="button" 
      data-action="shadowPlace"
      class="cottonfall-fx-button"
    >
      <i class="fas fa-user-secret"></i>
      Something in the Fog
    </button>


  </section>

  

  <section class="cottonfall-fx-section cottonfall-fx-future">
    <h2>Coming Later</h2>

    <div class="cottonfall-fx-placeholder">
      <i class="fas fa-radio"></i>
      Emergency Broadcast
    </div>
  </section>

</div>
